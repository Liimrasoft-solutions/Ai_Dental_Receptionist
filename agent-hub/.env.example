# Copy to api/.env (and the repo root for docker compose). Fake values only; real keys go in the secrets store.
DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5432/hub
CORS_ORIGINS=http://localhost:3001
AUTH_MODE=dev
# The Retell API key that has the "webhook" badge in the Retell dashboard
RETELL_API_KEY=
MONTHLY_BUDGET_USD=2000
CLINIC_TIMEZONE=America/Chicago
OFFICE_OPEN_HOUR=8
OFFICE_CLOSE_HOUR=17
